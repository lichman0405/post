{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-rd.example/schemas/rsg-manifest.schema.json",
  "title": "RSGManifest",
  "description": "Entity-shape schema for a persisted scientific object. It is NOT a request DTO: do not bind a client-supplied body directly to it. The fields id, version, schema_ref, lifecycle_state, created_by, created_at and visibility_policy_id are server-authoritative (docs/23 \u00a73, docs/12 \u00a73).",
  "type": "object",
  "required": [
    "format_version",
    "project_id",
    "state_id",
    "generated_at",
    "object_versions",
    "relation_versions",
    "blob_refs",
    "git_ref",
    "state_hash"
  ],
  "properties": {
    "format_version": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "state_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "schema_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "object_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relation_versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blob_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "hash"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          }
        }
      }
    },
    "git_ref": {
      "type": "object",
      "required": [
        "repository_id",
        "commit_sha"
      ],
      "properties": {
        "repository_id": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        }
      }
    },
    "state_hash": {
      "type": "string"
    }
  },
  "additionalProperties": false
}