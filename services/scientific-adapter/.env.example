# scientific-adapter configuration reference (T0004).
# PLACEHOLDERS ONLY — copy to .env.<layer> (git-ignored) and fill in real
# values there; never commit real secrets.

# Layer selection — required. dev | test | prod. No default: a missing or
# ambiguous layer refuses to start (exit code 2, error names the variable).
POST_ENV=dev

# Listen address (defaults: 127.0.0.1 / 9000; the --host/--port CLI flags
# override these when given). The adapter validates its own environment
# independently of the Go core and the web app.
POST_SCIENTIFIC_ADAPTER_HOST=127.0.0.1
POST_SCIENTIFIC_ADAPTER_PORT=9000
