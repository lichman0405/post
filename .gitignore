# secrets / local environment
.env
.env.*
!.env.example
*.pem
*.key

# orchestrator transient state (Supervisor-owned runtime; never committed)
.worktrees/
.rddev/
# Supervisor work worktrees (`rddev branch create --worktree post-wt/...`). Same
# class as /api /rddev below: a whole checkout of this repository, one `git add
# -A` away from being committed from the main tree. Ignoring it here is what
# keeps that from being a thing anybody has to remember.
/post-wt/
# rddev state-file lock (derived from the state file's directory; see
# internal/devorchestrator/store.go lockPathFor)
.task_status.lock

# Go
/bin/
*.test
coverage.out
# Binaries from `go build ./cmd/<name>` without -o, which drop <name> in
# the repo root. A Worker building a binary would otherwise leave a ~16MB
# untracked artifact that the collect scope check reports as an
# out-of-scope change - a build artefact is not a source change.
/api
/worker
/mcp-server
/rddev
/devredis

# Node / Next
node_modules/
.next/
out/
coverage/

# Python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Backup/restore drill artifacts (T1110, docs/37). A drill writes a database
# dump, blob copies and git mirrors — tens of megabytes of data that is a
# copy of an environment, never a source change. This is the drill's default
# output directory (backupdr.DefaultArtifactsRelPath); the drill also
# REFUSES any other location inside the working tree, so this entry and the
# Go constant are the two halves of one rule and must be changed together.
.backup-dr/
