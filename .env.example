# POST configuration reference (T0004). PLACEHOLDERS ONLY — copy this file
# to .env.<layer> and fill in real values there; never commit real secrets.
# Every layer file (.env.dev / .env.test / .env.prod) is git-ignored.

# ---------------------------------------------------------------------------
# Layer selection — required everywhere, in every language.
# dev | test | prod. There is no default: a missing or ambiguous layer
# refuses to start (fail closed).
POST_ENV=dev

# ---------------------------------------------------------------------------
# Go core (internal/config — typed loader, validated at startup)
# HTTP API listen address (neutral default: :8080)
POST_API_ADDR=:8080
# MCP server listen address (neutral default: :9080)
POST_MCP_ADDR=:9080

# PostgreSQL semantic store. The password has NO default in any layer:
# dev/test credentials must come from an explicit layer file.
POST_DB_HOST=127.0.0.1
POST_DB_PORT=5432
POST_DB_USER=postgres
POST_DB_PASSWORD=change-me
POST_DB_NAME=post
POST_DB_SSLMODE=disable        # disable|allow|prefer|require|verify-ca|verify-full

# Redis (cache / async jobs)
POST_REDIS_ADDR=127.0.0.1:6379

# S3-compatible blob store (MinIO locally). Endpoint must be an http(s) URL;
# credentials have no default and are never echoed (redacted in all output).
POST_BLOB_ENDPOINT=http://127.0.0.1:9000
POST_BLOB_ACCESS_KEY=change-me
POST_BLOB_SECRET_KEY=change-me
POST_BLOB_BUCKET=post
POST_BLOB_USE_TLS=false

# Internal Gitea provider (infrastructure only, ADR-019). The token has no
# default; the base URL is redacted in output if it ever embeds credentials.
POST_GITEA_BASE_URL=http://127.0.0.1:3000
POST_GITEA_TOKEN=change-me

# ---------------------------------------------------------------------------
# Next.js web app (apps/web/lib/config.ts — validates its own environment)
# The web app has no backend of its own; both URLs are required and must be
# absolute http(s) URLs. A missing variable is never satisfied by another
# service's variable.
API_BASE_URL=http://127.0.0.1:8080
SCIENTIFIC_ADAPTER_URL=http://127.0.0.1:9100

# ---------------------------------------------------------------------------
# Python scientific adapter
# (services/scientific-adapter/src/post_scientific_adapter/config.py)
# 9100, not 9000: 9000/9001 are the MinIO S3 API/console ports (T0006 fix).
POST_SCIENTIFIC_ADAPTER_HOST=127.0.0.1
POST_SCIENTIFIC_ADAPTER_PORT=9100

# ---------------------------------------------------------------------------
# Layer files
#
#   cp .env.example .env.dev     # local development values (dev-only creds
#                                # come from the infra stack, never from
#                                # committed example files)
#   cp .env.example .env.test    # test values
#   cp .env.example .env.prod    # production values (real secrets)
#
# The Go loader and the adapter load only the file matching POST_ENV; a
# mismatched layer file is refused, so a value can never silently fall back
# across layers. Process environment values override layer files.
