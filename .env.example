# POST configuration reference (T0004). PLACEHOLDERS ONLY — copy this file
# to .env.<layer> and fill in real values there; never commit real secrets.
# Every layer file (.env.dev / .env.test / .env.prod) is git-ignored.

# ---------------------------------------------------------------------------
# Layer selection — required everywhere, in every language.
# dev | test | prod. There is no default: a missing or ambiguous layer
# refuses to start (fail closed).
POST_ENV=dev

# ---------------------------------------------------------------------------
# Go core (internal/config — typed loader, validated at startup)
# HTTP API listen address (neutral default: :8080)
POST_API_ADDR=:8080
# MCP server listen address (neutral default: :9080)
POST_MCP_ADDR=:9080

# PostgreSQL semantic store. The password has NO default in any layer:
# dev/test credentials must come from an explicit layer file.
POST_DB_HOST=127.0.0.1
POST_DB_PORT=5432
POST_DB_USER=postgres
POST_DB_PASSWORD=change-me
POST_DB_NAME=post
POST_DB_SSLMODE=disable        # disable|allow|prefer|require|verify-ca|verify-full

# Redis (cache / async jobs)
POST_REDIS_ADDR=127.0.0.1:6379

# S3-compatible blob store (MinIO locally). Endpoint must be an http(s) URL;
# credentials have no default and are never echoed (redacted in all output).
POST_BLOB_ENDPOINT=http://127.0.0.1:9000
POST_BLOB_ACCESS_KEY=change-me
POST_BLOB_SECRET_KEY=change-me
POST_BLOB_BUCKET=post
POST_BLOB_USE_TLS=false

# Internal Gitea provider (infrastructure only, ADR-019). The token has no
# default; the base URL is redacted in output if it ever embeds credentials.
POST_GITEA_BASE_URL=http://127.0.0.1:3000
POST_GITEA_TOKEN=change-me
# Where Gitea delivers push webhooks — the platform API's own webhook
# endpoint (T0301 registers it on every provisioned repository; T0305
# builds the receiver). Required: the URL must be reachable FROM the
# Gitea container, so the API's hostname as seen from that container.
# Local dev (Gitea runs in Docker, the API on the host): the docker
# bridge gateway of the compose network reaches the host, e.g.
#   docker network inspect $(docker inspect post-gitea-1 --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}') --format '{{(index .IPAM.Config 0).Gateway}}'
# POST_GITEA_WEBHOOK_URL=http://<that-gateway>:8080/api/v1/git/hooks/gitea
# Production: the API's public URL. Leave unset (or blank) to run without
# provisioning: the API starts with the feature off and logs which keys
# are missing. A placeholder copied as-is would be an INVALID value and
# would refuse to start — so the commented form above is the template.
# POST_GITEA_WEBHOOK_URL=http://127.0.0.1:8080/api/v1/git/hooks/gitea

# Scoped git user tokens (T0304): the instance admin's credentials, used
# for exactly one thing — creating per-user shadow accounts and
# minting/revoking their scoped access tokens (Gitea 1.27 only accepts
# basic auth on its token-management API). The username defaults to
# "postadmin" (init-gitea.sh's admin); the password has no default. Both
# unset (or a blank password) → the git-token feature is off: the API
# starts, answers 503 on the git-token routes and logs which keys are
# missing. The password is secret-shaped and never echoed in output.
#POST_GITEA_ADMIN_USER=postadmin
#POST_GITEA_ADMIN_PASSWORD=change-me

# Authentication (internal/application/authn — T0101). All values have dev
# defaults and are optional: the API starts without them. The defaults are
# stated here in comments — the repo secret scanner treats any POST_AUTH_*
# key as secret-shaped, so only explicit secret values get key= lines.
# Origin the web app is served from; the API's CORS and OIDC completion
# redirects are bound to it (no path, scheme://host[:port]).
POST_WEB_ORIGIN=http://127.0.0.1:3000
# Server-side session lifetime; Go duration 1m..720h (default 24h).
#POST_AUTH_SESSION_TTL=24h
# Login rate limits: attempts per email / per IP in the window
# (fixed-window; the limiter is fail-closed when Redis is unavailable).
# Defaults: 5 / 20 / 1m.
#POST_AUTH_LOGIN_PER_EMAIL=5
#POST_AUTH_LOGIN_PER_IP=20
#POST_AUTH_LOGIN_WINDOW=1m
# Signup rate limit: attempts per IP in the same window (each signup burns
# the same argon2id work plus a database insert). Default: 10.
#POST_AUTH_SIGNUP_PER_IP=10
# OIDC is enabled exactly when the issuer is set; client id and secret are
# then required (the secret is never echoed in output). The API's callback
# endpoint is /api/v1/auth/oidc/callback (request-derived redirect_uri).
#POST_OIDC_ISSUER=https://your-provider.example
#POST_OIDC_CLIENT_ID=change-me
#POST_OIDC_CLIENT_SECRET=change-me

# ---------------------------------------------------------------------------
# Next.js web app (apps/web/lib/config.ts — validates its own environment)
# The web app has no backend of its own; both URLs are required and must be
# absolute http(s) URLs. A missing variable is never satisfied by another
# service's variable.
API_BASE_URL=http://127.0.0.1:8080
SCIENTIFIC_ADAPTER_URL=http://127.0.0.1:9100

# ---------------------------------------------------------------------------
# Python scientific adapter
# (services/scientific-adapter/src/post_scientific_adapter/config.py)
# 9100, not 9000: 9000/9001 are the MinIO S3 API/console ports (T0006 fix).
POST_SCIENTIFIC_ADAPTER_HOST=127.0.0.1
POST_SCIENTIFIC_ADAPTER_PORT=9100

# ---------------------------------------------------------------------------
# External Reference fetch (internal/rsg/externalref — T0508)
# The V1 manual-refresh DOI adapter has no config wiring yet: its defaults
# are compile-time constants (resolver https://doi.org, 10s fetch timeout,
# 1 MiB metadata cap), and the consuming API task owns the env surface.
# The SSRF policy (https-only, no private/loopback/link-local/reserved
# address space, re-checked on every redirect hop — docs/23 §7, docs/54
# #5) is structural and deliberately has no off switch.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Layer files
#
#   cp .env.example .env.dev     # local development values (dev-only creds
#                                # come from the infra stack, never from
#                                # committed example files)
#   cp .env.example .env.test    # test values
#   cp .env.example .env.prod    # production values (real secrets)
#
# The Go loader and the adapter load only the file matching POST_ENV; a
# mismatched layer file is refused, so a value can never silently fall back
# across layers. Process environment values override layer files.
