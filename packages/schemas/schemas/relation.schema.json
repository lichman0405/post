{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RSGRelation",
  "type": "object",
  "required": [
    "id",
    "version",
    "type",
    "source_version_ref",
    "target_version_ref",
    "created_by",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string"
    },
    "source_version_ref": {
      "type": "string"
    },
    "target_version_ref": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "created_by": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}