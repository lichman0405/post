{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-rd.example/schemas/research-asset-version.schema.json",
  "title": "ResearchAssetVersion",
  "description": "Entity-shape schema for a persisted scientific object. It is NOT a request DTO: do not bind a client-supplied body directly to it. The fields id, version, schema_ref, lifecycle_state, created_by, created_at and visibility_policy_id are server-authoritative (docs/23 \u00a73, docs/12 \u00a73).",
  "type": "object",
  "required": [
    "asset_id",
    "version",
    "asset_type",
    "origin_refs",
    "rights",
    "integrity_hash"
  ],
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "asset_type": {
      "enum": [
        "dataset",
        "protocol",
        "material_collection",
        "benchmark"
      ]
    },
    "origin_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "rights": {
      "type": "object",
      "additionalProperties": true
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "creator_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "integrity_hash": {
      "type": "string"
    }
  },
  "additionalProperties": false
}