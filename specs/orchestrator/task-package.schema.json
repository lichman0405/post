{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker Task Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "goal", "baseline_sha", "allowed_scope", "forbidden_scope", "requirements", "acceptance_criteria", "required_tests", "relevant_specs", "decision_level_max"],
  "properties": {
    "task_id": {"type": "string", "pattern": "^T[0-9]{4}$"},
    "goal": {"type": "string"},
    "baseline_sha": {"type": "string", "minLength": 7},
    "allowed_scope": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "forbidden_scope": {"type": "array", "items": {"type": "string"}},
    "requirements": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}},
    "required_tests": {"type": "array", "items": {"type": "string"}},
    "relevant_specs": {"type": "array", "items": {"type": "string"}},
    "decision_level_max": {"enum": ["L0", "L1", "L2"]},
    "max_turns": {"type": ["integer", "null"], "minimum": 1},
    "max_budget_usd": {"type": ["number", "null"], "minimum": 0}
  }
}
