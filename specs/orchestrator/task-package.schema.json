{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Worker Task Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "goal",
    "baseline_sha",
    "allowed_scope",
    "forbidden_scope",
    "requirements",
    "acceptance_criteria",
    "required_tests",
    "relevant_specs",
    "decision_level_max",
    "migration_number"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T[0-9]{4}$"
    },
    "goal": {
      "type": "string"
    },
    "baseline_sha": {
      "type": "string",
      "minLength": 7
    },
    "migration_number": {
      "type": "integer",
      "minimum": 0,
      "description": "The migration number reserved for this task at dispatch. Use it if the task adds a migration; never choose your own - parallel Workers reserve theirs from the same allocator and a number read from the repository's index collides with branches that index cannot see."
    },
    "allowed_scope": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "forbidden_scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_tests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relevant_specs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_level_max": {
      "enum": [
        "L0",
        "L1",
        "L2"
      ]
    },
    "max_turns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "max_budget_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "supervisor_scope_narrowing": {
      "type": "string",
      "description": "The Supervisor's task-specific narrowing and rulings, addressed to the Worker. It decides what the requirements leave open (which reading of an ambiguous sentence is the intended one, where the boundary is), so it is part of the contract; it must reach the Worker, not stop at the ledger (#274)."
    }
  }
}
