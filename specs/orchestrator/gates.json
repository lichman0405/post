      "steps": [
        {
          "run": "bash tests/security/owasp-smoke.sh"
        }
      ],
      "requires_tasks": [
        "T1106"
      ]
    },
    "mof-canonical": {
      "steps": [
        {
          "run": "bash tests/acceptance/mof-canonical-workflow.sh"
        }
      ],
      "requires_tasks": [
        "T1202"
      ]
    },
    "observability": {
      "steps": [
        {
          "run": "corepack enable pnpm && pnpm install --frozen-lockfile"
        },
        {
          "run": "pip install uv==0.12.13 && cd services/scientific-adapter && uv sync --frozen"
        },
        {
          "run": "docker pull pgvector/pgvector:0.8.6-pg16"
        },
        {
          "run": "make observability-smoke"
        }
      ]
    },
    "a11y": {
      "steps": [
        {
          "run": "corepack enable pnpm && pnpm install --frozen-lockfile"
        },
        {
          "run": "make a11y",
          "env": {
            "POSTGRES_TEST_ADMIN_URL": "postgres://postgres:postgres_dev_pw@127.0.0.1:5432/post",
            "A11Y_API_ADDR": "127.0.0.1:18197",
            "A11Y_WEB_PORT": "31117"
          }
        }
      ]
    },
    "i18n": {
      "steps": [
        {
          "run": "corepack enable pnpm && pnpm install --frozen-lockfile"
        },
        {
          "run": "make i18n",
          "env": {
            "POSTGRES_TEST_ADMIN_URL": "postgres://postgres:postgres_dev_pw@127.0.0.1:5432/post",
            "I18N_API_ADDR": "127.0.0.1:18198",
            "I18N_WEB_PORT": "31118"
          }
        }
      ]
    },
    "security-master": {
      "steps": [
        {
          "name": "security-master: declare where the installers put their tools (go install -> GOPATH/bin, uv tool -> ~/.local/bin) so later steps find them",
          "run": "if [ -n \"${GITHUB_PATH:-}\" ]; then echo \"$(go env GOPATH)/bin\" >> \"$GITHUB_PATH\"; echo \"$HOME/.local/bin\" >> \"$GITHUB_PATH\"; fi"
        },
        {
          "name": "security-master: pnpm (corepack) \u2014 the SAST-Node and SBOM-Node rows run it, at the pin package.json declares",
          "run": "corepack enable pnpm"
        },
        {
          "name": "security-master: uv \u2014 the bandit install and the SBOM-Python row run it",
          "run": "pip install uv==0.12.13"
        },
        {
          "name": "security-master: redis-cli \u2014 the owasp-smoke row resets and reads back its own edge counters through it before measuring the rate-limit boundary (installed only when the runner does not already ship it)",
          "run": "command -v redis-cli >/dev/null || { sudo apt-get update -qq && sudo apt-get install -y --no-install-recommends redis-tools; }"
        },
        {
          "name": "security-master: PyYAML \u2014 the deploy-template row's validator parses the staging compose file as YAML (the same install the spec-validation job does)",
          "run": "pip install pyyaml"
        },
        {
          "name": "security-master: govulncheck (the vuln-go row's instrument; pinned here because nothing else pins it)",
          "run": "go install golang.org/x/vuln/cmd/govulncheck@v1.8.0"
        },
        {
          "name": "security-master: install every pinned scanner (make security-tools)",
          "run": "make security-tools"
        },
        {
          "name": "security-master: the Master Security/Quality Gate (docs/23 \u00a711)",
          "run": "bash tests/security/master-security-gate.sh",
          "env": {
            "POSTGRES_TEST_ADMIN_URL": "postgres://postgres:postgres_dev_pw@127.0.0.1:5432/post",
            "POST_G3_REDIS_ADDR": "127.0.0.1:6379"
          }
        }
      ]
    }
  },
