{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchAssetVersion",
  "type": "object",
  "required": [
    "asset_id",
    "version",
    "asset_type",
    "origin_refs",
    "rights",
    "integrity_hash"
  ],
  "properties": {
    "asset_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "asset_type": {
      "enum": [
        "dataset",
        "protocol",
        "material_collection",
        "benchmark"
      ]
    },
    "origin_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "rights": {
      "type": "object",
      "additionalProperties": true
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "creator_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrity_hash": {
      "type": "string"
    }
  },
  "additionalProperties": false
}